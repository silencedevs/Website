{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "paths": { "@/*": ["./*"] },
    "types": ["vite/client", "node"]
  },
  "include": ["components/**/*.tsx", "lib/**/*.ts", "src/client/**/*.tsx", "vite.config.ts"]
}
